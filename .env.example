# ── required ─────────────────────────────
API_ID=
API_HASH=
BOT_TOKEN=
OWNER_ID=
DB_URL=mongodb+srv://user:pass@cluster/...
DB_NAME=MangaBot

# ── limits ───────────────────────────────
MAX_BATCH=5                 # chapters per batch for normal users (raise/lower any time)
SUBSCRIBER_MAX_BATCH=20     # chapters per batch for Subscribers (0 = unlimited / "all")
MONTHLY_LIMIT=500           # monthly chapters per normal user ...
MONTHLY_LIMIT_ENABLED=false # ... only enforced when ON (also: /monthly on|off in the bot)

# ── optional ─────────────────────────────
FORCE_SUB=                  # comma separated @channels / -100ids (or use /addfsub)
ADMINS=                     # extra admin ids, comma separated (or use /addadmin)
DEFAULT_FORMAT=pdf          # pdf | cbz | both
PICS=                       # comma separated image URLs used as card banners
UPDATES_URL=
CRAWLER_CONTACT=             # optional contact email included in scraper User-Agent
WORKERS=3                   # chapters processed in parallel
PAGE_CONCURRENCY=8          # images downloaded in parallel per chapter
HEALTH_INTERVAL=1800        # seconds between 🟢/🔴 site checks
PORT=8080
